        "jsCode": "const result = [];\n\nfor (const item of $input.all()) {\n  const c = item.json;\n\n  result.push({\n    json: {\n      customer_id: c.customer_id,\n\n      phone_clean: c.phone_clean,\n\n      chat_title: c.chat_title,\n\n      chat_index: c.chat_index,\n\n      list_time: c.list_time,\n\n      list_preview: c.list_preview,\n\n      list_hash: c.list_hash,\n\n      old_list_hash: c.old_list_hash,\n\n      preview_type: c.preview_type,\n\n      has_unread: c.has_unread,\n\n      has_outgoing_icon: c.has_outgoing_icon,\n\n      is_changed: c.is_changed,\n\n      should_deep_read: c.should_deep_read\n    }\n  });\n}\n\nreturn result;"
