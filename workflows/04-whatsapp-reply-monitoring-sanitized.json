    {
      "parameters": {
        "jsCode": "const customers = [];\n\nfor (const item of $input.all()) {\n  const j = item.json;\n\n  if (!j.phone_clean) continue;\n\n  customers.push({\n    id: j.id,\n    customer_id: j.customer_id || '',\n    phone_clean: j.phone_clean,\n    last_list_hash: j.last_list_hash || '',\n    whatsapp_chat_title: j.whatsapp_chat_title || ''\n  });\n}\n\nreturn [\n  {\n    json: {\n      limit: 100,\n      customers\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "cf98fcb2-54f9-5135-81a9-95685a79be0c",
      "name": "提取手机号"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\n// 当前正在处理的客户（Loop Over Items）\nconst current = $('Loop Over Items').first().json;\n\nconst output = [];\n\n\n/* ===========================================\n   人工回复（Customer Reply）\n=========================================== */\n\nfor (const item of (data.replied_results || [])) {\n\n  output.push({\n    json: {\n\n      customer_id: current.customer_id,\n\n      phone_clean: current.phone_clean,\n\n      whatsapp_outreach_status: \"replied\",\n\n      whatsapp_last_reply_content:\n        item.last_customer_message || \"\",\n\n      whatsapp_last_reply_at:\n        new Date().toISOString(),\n\n      whatsapp_conversation_status:\n        \"customer_replied\",\n\n      reply_type:\n        \"manual_reply\",\n\n      updated_at:\n        new Date().toISOString(),\n\n      full_data: item\n\n    }\n  });\n\n}\n\n\n\n/* ===========================================\n   自动回复（Auto Reply）\n=========================================== */\n\nfor (const item of (data.auto_reply_results || [])) {\n\n  output.push({\n    json: {\n\n      customer_id: current.customer_id,\n\n      phone_clean: current.phone_clean,\n\n      whatsapp_outreach_status: \"replied\",\n\n      whatsapp_last_reply_content:\n        item.last_customer_message || \"\",\n\n      whatsapp_last_reply_at:\n        new Date().toISOString(),\n\n      whatsapp_conversation_status:\n        \"auto_reply\",\n\n      reply_type:\n        \"auto_reply\",\n\n      updated_at:\n        new Date().toISOString(),\n\n      full_data: item\n\n    }\n  });\n\n}\n\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
